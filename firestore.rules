rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function canRequestService() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().role == 'CUSTOMER' && profile().status == 'ACTIVE';
    }

    match /admins/{uid} {
      allow read: if own(uid) || isAdmin();
      allow write: if false; // Bootstrap the first admin only in Firebase Console.
    }
    match /users/{uid} {
      allow create: if own(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'CUSTOMER'
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.keys().hasOnly(['uid','firstName','lastName','fullName','phone','role','status','createdAt']);
      allow read: if own(uid) || isAdmin();
      allow update: if isAdmin() || (own(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName','lastName','fullName','phone']));
      allow delete: if isAdmin();
    }
    match /serviceRequests/{requestId} {
      allow create: if canRequestService()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.keys().hasOnly(['userId','service','status','createdAt']);
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
  }
}